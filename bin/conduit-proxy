#!/usr/bin/env python3
"""
Conduit - bridges your ChatGPT Business/Enterprise Codex OAuth tokens into any
OpenAI-compatible tool (opencode, Continue, Cursor BYOK, etc).

Listens on a local port, exposes /v1/chat/completions + /v1/models, and forwards
to https://chatgpt.com/backend-api/codex/responses using your tokens. Auto-refreshes
expired tokens. Surfaces real model metadata (context window, modalities) live
from the Codex backend.

Configuration (environment variables):
  CONDUIT_PORT          - port to listen on (default: 8081)
  CONDUIT_AUTH_FILE     - path to Codex auth.json (default: ~/.codex/auth.json)
  CONDUIT_LOG_REQUESTS  - if "1", dump each request to /tmp/conduit-requests.log
"""

import json
import os
import subprocess
import threading
import time
from http.server import HTTPServer, BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse
import requests
import base64

CODEX_AUTH_FILE = os.environ.get("CONDUIT_AUTH_FILE") or os.path.expanduser("~/.codex/auth.json")
CODEX_BASE_URL = "https://chatgpt.com/backend-api/codex"
OAUTH_ISSUER = "https://auth.openai.com"
CODEX_CLIENT_ID = "app_EMoamEEZ73f0CkXaXp7hrann"
CODEX_USER_AGENT = "Codex/1.0"
PROXY_PORT = int(os.environ.get("CONDUIT_PORT", "8081"))
LOG_REQUESTS = os.environ.get("CONDUIT_LOG_REQUESTS") == "1"
REQUEST_LOG_PATH = "/tmp/conduit-requests.log"

class TokenManager:
    def __init__(self):
        self.tokens = None
        self.account_id = None
        self.load_tokens()
    
    def load_tokens(self):
        """Load tokens from Codex auth.json"""
        try:
            with open(CODEX_AUTH_FILE) as f:
                auth = json.load(f)
            self.tokens = auth.get("tokens")
            if self.tokens:
                id_token = self.tokens.get("id_token", "")
                if id_token:
                    payload = id_token.split('.')[1]
                    payload += '=' * (4 - len(payload) % 4)
                    decoded = json.loads(base64.urlsafe_b64decode(payload))
                    auth_claims = decoded.get("https://api.openai.com/auth", {})
                    self.account_id = auth_claims.get("chatgpt_account_id")
                    print(f"Loaded tokens, account_id: {self.account_id}")
                    
                    # Check if token is expired
                    exp = decoded.get("exp", 0)
                    if exp < time.time():
                        print("Token expired, refreshing...")
                        self.refresh_token()
        except Exception as e:
            print(f"Error loading tokens: {e}")
            self.tokens = None
    
    def refresh_token(self):
        """Refresh the access token using refresh_token"""
        if not self.tokens or not self.tokens.get("refresh_token"):
            print("No refresh token available")
            return False
        
        try:
            refresh_token = self.tokens["refresh_token"]
            import urllib.parse
            data = urllib.parse.urlencode({
                'grant_type': 'refresh_token',
                'client_id': CODEX_CLIENT_ID,
                'refresh_token': refresh_token,
                'scope': 'openid profile email offline_access api.connectors.read api.connectors.invoke'
            })
            resp = requests.post(
                f"{OAUTH_ISSUER}/oauth/token",
                headers={"Content-Type": "application/x-www-form-urlencoded"},
                data=data,
                timeout=30
            )
            
            if resp.status_code == 200:
                token_data = resp.json()
                # Reload the full auth to get the id_token
                with open(CODEX_AUTH_FILE) as f:
                    auth = json.load(f)
                
                # Update tokens
                auth["tokens"]["access_token"] = token_data["access_token"]
                if "refresh_token" in token_data:
                    auth["tokens"]["refresh_token"] = token_data["refresh_token"]
                if "id_token" in token_data:
                    auth["tokens"]["id_token"] = token_data["id_token"]
                auth["last_refresh"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
                
                with open(CODEX_AUTH_FILE, "w") as f:
                    json.dump(auth, f, indent=2)
                
                self.load_tokens()
                print("Token refreshed successfully")
                return True
            else:
                print(f"Token refresh failed: {resp.status_code} {resp.text[:200]}")
                return False
        except Exception as e:
            print(f"Error refreshing token: {e}")
            return False
    
    def launch_codex_login(self):
        """Launch Codex login for browser-based authentication"""
        print("Launching Codex login...")
        try:
            # Launch codex auth - this will open browser
            proc = subprocess.Popen(
                ["codex", "auth"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE
            )
            # Wait for user to complete login
            proc.wait()
            
            # Reload tokens after login
            self.load_tokens()
            return True
        except Exception as e:
            print(f"Error launching Codex login: {e}")
            return False
    
    def get_valid_token(self):
        """Get a valid access token, refreshing if needed"""
        if not self.tokens:
            self.load_tokens()
        
        if not self.tokens:
            # Try launching Codex login
            self.launch_codex_login()
            self.load_tokens()
        
        # Check if token is about to expire (within 5 minutes)
        if self.tokens:
            try:
                id_token = self.tokens.get("id_token", "")
                payload = id_token.split('.')[1]
                payload += '=' * (4 - len(payload) % 4)
                decoded = json.loads(base64.urlsafe_b64decode(payload))
                exp = decoded.get("exp", 0)
                
                # Refresh if expiring within 5 minutes
                if exp < time.time() + 300:
                    print("Token expiring soon, refreshing...")
                    if not self.refresh_token():
                        print("Refresh failed, launching login...")
                        self.launch_codex_login()
            except:
                pass
        
        return self.tokens
    
    def handle_401(self):
        """Handle 401 error - try to refresh token"""
        print("Got 401, attempting token refresh...")
        if self.refresh_token():
            return True
        return self.launch_codex_login()


class ProxyHandler(BaseHTTPRequestHandler):
    token_manager = None
    protocol_version = "HTTP/1.1"
    
    def log_message(self, format, *args):
        print(f"[{self.log_date_time_string()}] {format % args}")
    
    def handle_one_request(self):
        """Override to catch ConnectionResetError gracefully"""
        try:
            super().handle_one_request()
        except (ConnectionResetError, BrokenPipeError, ConnectionAbortedError):
            self.close_connection = True
        except Exception as e:
            print(f"Request handler error: {e}")
            self.close_connection = True
    
    def get_token_manager(self):
        if not ProxyHandler.token_manager:
            ProxyHandler.token_manager = TokenManager()
        return ProxyHandler.token_manager
    
    def do_POST(self):
        parsed = urlparse(self.path)
        path = parsed.path
        
        if path == "/v1/chat/completions":
            self.handle_chat_completions()
        elif path == "/v1/images/generations":
            self.handle_image_generation()
        elif path == "/v1/images/edits":
            self.handle_image_edit()
        elif path == "/v1/images/variations":
            self.handle_image_variation()
        elif path == "/v1/files":
            self.handle_file_upload()
        elif path == "/v1/files/uploads":
            self.handle_file_upload()
        elif path == "/v1/embeddings":
            self.handle_embeddings()
        else:
            # For unknown endpoints, try to proxy to Codex backend
            self.handle_proxy_request()
    
    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path
        
        if path == "/v1/models":
            self.handle_models()
        elif path == "/v1/models/gpt-5.5":
            self.handle_model_info("gpt-5.5")
        elif path == "/v1/models/gpt-4o":
            self.handle_model_info("gpt-4o")
        elif path == "/v1/models/gpt-4o-mini":
            self.handle_model_info("gpt-4o-mini")
        else:
            self.handle_proxy_request()
    
    def handle_models(self):
        # Fetch authoritative model list from Codex backend (cached)
        models_data = self._fetch_codex_models()
        if models_data:
            response = {
                "object": "list",
                "data": [
                    {
                        "id": m.get("slug", ""),
                        "object": "model",
                        "created": 1700000000,
                        "owned_by": "openai",
                        # Surface authoritative metadata so clients can read truth
                        "context_window": m.get("context_window"),
                        "max_context_window": m.get("max_context_window"),
                        "display_name": m.get("display_name"),
                        "description": m.get("description"),
                        "input_modalities": m.get("input_modalities", []),
                        "supports_parallel_tool_calls": m.get("supports_parallel_tool_calls", False),
                        "supports_image_detail_original": m.get("supports_image_detail_original", False),
                        "default_reasoning_level": m.get("default_reasoning_level"),
                        "supported_reasoning_levels": [
                            r.get("effort") for r in m.get("supported_reasoning_levels", [])
                        ],
                    }
                    for m in models_data
                ]
            }
        else:
            # Fallback if backend fetch fails
            response = {
                "object": "list",
                "data": [
                    {"id": "gpt-5.5", "object": "model", "created": 1700000000, "owned_by": "openai", "context_window": 272000},
                    {"id": "gpt-5.4", "object": "model", "created": 1700000000, "owned_by": "openai", "context_window": 272000, "max_context_window": 1000000},
                    {"id": "gpt-5.4-mini", "object": "model", "created": 1700000000, "owned_by": "openai", "context_window": 272000},
                ]
            }
        body = json.dumps(response).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)
    
    # Cache for codex model metadata
    _models_cache = None
    _models_cache_ts = 0
    
    def _fetch_codex_models(self):
        """Fetch authoritative model list from Codex backend, cached for 1 hour"""
        now = time.time()
        if ProxyHandler._models_cache and (now - ProxyHandler._models_cache_ts) < 3600:
            return ProxyHandler._models_cache
        try:
            tokens = self.get_token_manager().get_valid_token()
            if not tokens:
                return None
            access_token = tokens.get("access_token")
            account_id = self.get_token_manager().account_id
            url = f"{CODEX_BASE_URL}/models?client_version=0.138.0"
            headers = {
                "Authorization": f"Bearer {access_token}",
                "User-Agent": "codex_cli_rs/0.138.0",
            }
            if account_id:
                headers["ChatGPT-Account-Id"] = account_id
            resp = requests.get(url, headers=headers, timeout=15)
            if resp.status_code == 200:
                data = resp.json()
                models = data.get("models", [])
                ProxyHandler._models_cache = models
                ProxyHandler._models_cache_ts = now
                self.log_message(f"Cached {len(models)} models from Codex")
                return models
        except Exception as e:
            self.log_message(f"Failed to fetch models: {e}")
        return None
    
    def handle_model_info(self, model_id):
        models = self._fetch_codex_models() or []
        for m in models:
            if m.get("slug") == model_id:
                model_info = {
                    "id": model_id,
                    "object": "model",
                    "created": 1700000000,
                    "owned_by": "openai",
                    "context_window": m.get("context_window"),
                    "max_context_window": m.get("max_context_window"),
                    "display_name": m.get("display_name"),
                    "description": m.get("description"),
                }
                break
        else:
            model_info = {
                "id": model_id,
                "object": "model",
                "created": 1700000000,
                "owned_by": "openai",
            }
        body = json.dumps(model_info).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)
    
    def handle_image_generation(self):
        """Handle image generation requests"""
        self.send_error(501, "Image generation not yet implemented")
    
    def handle_image_edit(self):
        """Handle image edit requests"""
        self.send_error(501, "Image edit not yet implemented")
    
    def handle_image_variation(self):
        """Handle image variation requests"""
        self.send_error(501, "Image variation not yet implemented")
    
    def handle_file_upload(self):
        """Handle file upload requests"""
        self.send_error(501, "File upload not yet implemented")
    
    def handle_embeddings(self):
        """Handle embedding requests"""
        self.send_error(501, "Embeddings not yet implemented")
    
    def handle_proxy_request(self):
        """Generic proxy handler for unknown endpoints"""
        parsed = urlparse(self.path)
        path = parsed.path
        
        tokens = self.get_token_manager().get_valid_token()
        if not tokens:
            self.send_error(401, "Not authenticated")
            return
        
        access_token = tokens.get("access_token")
        
        # Read request body
        content_length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(content_length) if content_length > 0 else None
        
        headers = {
            "Authorization": f"Bearer {access_token}",
            "Content-Type": "application/json",
            "User-Agent": CODEX_USER_AGENT,
            "Origin": "https://chatgpt.com",
            "Referer": "https://chatgpt.com/"
        }
        
        tm = self.get_token_manager()
        if tm.account_id:
            headers["ChatGPT-Account-Id"] = tm.account_id
        
        try:
            # Map OpenAI paths to Codex paths
            codex_path = path.replace("/v1/", "/")
            url = f"{CODEX_BASE_URL}{codex_path}"
            
            self.log_message(f"Proxying {path} -> {url}")
            
            response = requests.request(
                "POST" if body else "GET",
                url,
                headers=headers,
                data=body,
                stream=False,
                timeout=120
            )
            
            # Handle 401 - try to refresh token
            if response.status_code == 401:
                if self.get_token_manager().handle_401():
                    # Retry with new token
                    tokens = self.get_token_manager().get_valid_token()
                    headers["Authorization"] = f"Bearer {tokens.get('access_token')}"
                    response = requests.request(
                        "POST" if body else "GET",
                        url,
                        headers=headers,
                        data=body,
                        timeout=120
                    )
            
            content = response.content
            self.send_response(response.status_code)
            self.send_header("Content-Type", response.headers.get("Content-Type", "application/json"))
            self.send_header("Content-Length", str(len(content)))
            self.send_header("Connection", "close")
            self.end_headers()
            self.wfile.write(content)
            
        except requests.RequestException as e:
            self.log_message(f"Proxy error: {e}")
            self.send_error(502, str(e))
    
    def handle_chat_completions(self):
        tokens = self.get_token_manager().get_valid_token()
        if not tokens:
            self.send_error(401, "Not authenticated")
            return
        
        access_token = tokens["access_token"]
        
        content_length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(content_length)
        
        # Optional request logging for debugging (redacts base64 data URLs)
        if LOG_REQUESTS:
            try:
                import re, datetime
                request_log = body.decode('utf-8', errors='replace')
                request_log = re.sub(r'(data:[^,]+,)[A-Za-z0-9+/=]{200,}', r'\1<...base64...>', request_log)
                with open(REQUEST_LOG_PATH, 'a') as f:
                    f.write(f"\n=== {datetime.datetime.now().isoformat()} ({content_length} bytes) ===\n")
                    f.write(request_log[:8000])
                    f.write("\n")
            except Exception:
                pass
        
        try:
            request_data = json.loads(body)
        except:
            self.send_error(400, "Invalid JSON")
            return
        
        model = request_data.get("model", "gpt-5.5")
        # Map our virtual high-effort model to actual model
        reasoning_overrides = {}
        if model == "gpt-5.5-high":
            model = "gpt-5.5"
            reasoning_overrides = {"effort": "high", "summary": "detailed"}
        elif model == "gpt-5.5-low":
            model = "gpt-5.5"
            reasoning_overrides = {"effort": "low", "summary": "auto"}
        messages = request_data.get("messages", [])
        client_stream = request_data.get("stream", False)
        tools = request_data.get("tools", [])
        
        # Convert OpenAI messages to Codex Responses API format
        instructions_parts = []
        input_items = []
        
        for msg in messages:
            role = msg.get("role", "")
            content = msg.get("content", "")
            
            if role == "system":
                # System messages become instructions
                if isinstance(content, str):
                    instructions_parts.append(content)
                elif isinstance(content, list):
                    for part in content:
                        if isinstance(part, dict) and part.get("type") == "text":
                            instructions_parts.append(part.get("text", ""))
            elif role == "tool":
                # Tool result message
                input_items.append({
                    "type": "function_call_output",
                    "call_id": msg.get("tool_call_id", ""),
                    "output": content if isinstance(content, str) else json.dumps(content)
                })
            elif role == "assistant":
                # Assistant message - might have content and/or tool_calls
                if msg.get("tool_calls"):
                    for tc in msg["tool_calls"]:
                        input_items.append({
                            "type": "function_call",
                            "call_id": tc.get("id", ""),
                            "name": tc.get("function", {}).get("name", ""),
                            "arguments": tc.get("function", {}).get("arguments", "")
                        })
                if content:
                    if isinstance(content, str):
                        input_items.append({
                            "type": "message",
                            "role": "assistant",
                            "content": [{"type": "output_text", "text": content}]
                        })
                    else:
                        input_items.append({
                            "type": "message",
                            "role": "assistant",
                            "content": content
                        })
            else:  # user
                if isinstance(content, str):
                    input_items.append({
                        "type": "message",
                        "role": "user",
                        "content": [{"type": "input_text", "text": content}]
                    })
                elif isinstance(content, list):
                    # Handle multi-part content (text + images)
                    converted_parts = []
                    for part in content:
                        if isinstance(part, dict):
                            if part.get("type") == "text":
                                converted_parts.append({"type": "input_text", "text": part.get("text", "")})
                            elif part.get("type") == "image_url":
                                url = part.get("image_url", {}).get("url", "")
                                converted_parts.append({"type": "input_image", "image_url": url})
                    input_items.append({
                        "type": "message",
                        "role": "user",
                        "content": converted_parts
                    })
        
        instructions = "\n\n".join(instructions_parts) if instructions_parts else "You are a helpful coding assistant."
        
        # Codex API requires stream: true always
        codex_payload = {
            "model": model,
            "input": input_items,
            "store": False,
            "stream": True,
            "instructions": instructions
        }
        
        # Add reasoning config for thinking models (gpt-5.5 and similar)
        # opencode may pass reasoning_effort or we can default to medium with auto summary
        reasoning_effort = reasoning_overrides.get("effort", request_data.get("reasoning_effort", "medium"))
        reasoning_summary = reasoning_overrides.get("summary", request_data.get("reasoning_summary", "auto"))
        if model.startswith("gpt-5") or "reasoning" in model.lower():
            codex_payload["reasoning"] = {
                "effort": reasoning_effort,
                "summary": reasoning_summary
            }
        
        # Add tools if provided (convert OpenAI tool format to Responses API)
        if tools:
            codex_tools = []
            for tool in tools:
                if tool.get("type") == "function":
                    fn = tool.get("function", {})
                    codex_tools.append({
                        "type": "function",
                        "name": fn.get("name", ""),
                        "description": fn.get("description", ""),
                        "parameters": fn.get("parameters", {}),
                        "strict": fn.get("strict", False)
                    })
            if codex_tools:
                codex_payload["tools"] = codex_tools
        
        # Add tool_choice if provided
        if "tool_choice" in request_data:
            codex_payload["tool_choice"] = request_data["tool_choice"]
        
        # Add parallel_tool_calls if provided
        if "parallel_tool_calls" in request_data:
            codex_payload["parallel_tool_calls"] = request_data["parallel_tool_calls"]
        
        headers = {
            "Authorization": f"Bearer {access_token}",
            "Content-Type": "application/json",
            "User-Agent": CODEX_USER_AGENT,
            "Accept": "text/event-stream",
            "Origin": "https://chatgpt.com",
            "Referer": "https://chatgpt.com/"
        }
        
        tm = self.get_token_manager()
        if tm.account_id:
            headers["ChatGPT-Account-Id"] = tm.account_id
        
        try:
            url = f"{CODEX_BASE_URL}/responses"
            
            response = requests.post(
                url,
                headers=headers,
                json=codex_payload,
                stream=True,  # Always stream from Codex
                timeout=120
            )
            
            # Handle 401 - try to refresh token
            if response.status_code == 401:
                if tm.handle_401():
                    # Retry with new token
                    tokens = tm.get_valid_token()
                    headers["Authorization"] = f"Bearer {tokens['access_token']}"
                    response = requests.post(
                        url,
                        headers=headers,
                        json=codex_payload,
                        stream=True,
                        timeout=120
                    )
            
            # If upstream error, forward error response directly
            if response.status_code >= 400:
                error_body = response.content
                self.log_message(f"Codex error {response.status_code}: {error_body[:500]}")
                # Try to format as OpenAI error
                try:
                    err = json.loads(error_body)
                    detail = err.get("detail", str(err))
                    out_body = json.dumps({"error": {"message": detail, "type": "api_error", "code": str(response.status_code)}}).encode()
                except Exception:
                    out_body = error_body
                self.send_response(response.status_code)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(out_body)))
                self.send_header("Connection", "close")
                self.end_headers()
                self.wfile.write(out_body)
                return
            
            # For streaming clients, send headers up front (chunked encoding).
            # For non-streaming clients, we'll collect the full body first then
            # send headers with Content-Length, so HTTP/1.1 clients know when
            # the response ends without the connection lingering.
            if client_stream:
                self.send_response(response.status_code)
                self.send_header("Content-Type", "text/event-stream")
                self.send_header("Cache-Control", "no-cache")
                self.send_header("Transfer-Encoding", "chunked")
                self.send_header("Connection", "keep-alive")
                self.end_headers()
            
            def write_chunk(data):
                """Write data using HTTP/1.1 chunked transfer encoding"""
                if not data:
                    return
                if isinstance(data, str):
                    data = data.encode()
                # Chunked format: <hex-size>\r\n<data>\r\n
                chunk = f"{len(data):x}\r\n".encode() + data + b"\r\n"
                self.wfile.write(chunk)
                self.wfile.flush()
            
            def write_chunk_end():
                """Write the final chunk to end the stream"""
                self.wfile.write(b"0\r\n\r\n")
                self.wfile.flush()
            
            # Always collect from streaming response
            full_text = ""
            full_reasoning = ""
            tool_calls = []
            response_id = f"chatcmpl-{int(time.time()*1000)}"
            created_ts = int(time.time())
            
            # Send initial role chunk for streaming
            if client_stream:
                initial = {
                    'id': response_id,
                    'object': 'chat.completion.chunk',
                    'created': created_ts,
                    'model': model,
                    'choices': [{'index': 0, 'delta': {'role': 'assistant', 'content': ''}, 'finish_reason': None}]
                }
                try:
                    write_chunk(f"data: {json.dumps(initial)}\n\n")
                except (BrokenPipeError, ConnectionResetError):
                    return
            
            buffer = ""
            client_disconnected = False
            stream_state = {'has_tool_calls': False, 'usage': None}
            try:
                for chunk in response.iter_content(chunk_size=None):
                    if client_disconnected:
                        break
                    if chunk:
                        buffer += chunk.decode('utf-8', errors='replace')
                        while '\n' in buffer:
                            line, buffer = buffer.split('\n', 1)
                            line = line.strip()
                            if not line:
                                continue
                            # Track state for both modes
                            self.update_stream_state(line, stream_state)
                            # For streaming client, convert and forward
                            if client_stream:
                                converted = self.convert_sse_to_openai(line, model, response_id, created_ts, stream_state)
                                if converted:
                                    try:
                                        write_chunk(f"data: {converted}\n\n")
                                    except (BrokenPipeError, ConnectionResetError):
                                        client_disconnected = True
                                        break
                            else:
                                # For non-streaming client, collect text, reasoning, and tool calls
                                parsed = self.extract_text_from_sse(line)
                                if parsed:
                                    full_text += parsed
                                reasoning = self.extract_reasoning_from_sse(line)
                                if reasoning:
                                    full_reasoning += reasoning
                                tc = self.extract_tool_call_from_sse(line)
                                if tc:
                                    tool_calls.append(tc)
            except (BrokenPipeError, ConnectionResetError):
                client_disconnected = True
            
            # For streaming client, send final [DONE]
            if client_stream and not client_disconnected:
                try:
                    write_chunk(b"data: [DONE]\n\n")
                    write_chunk_end()
                except (BrokenPipeError, ConnectionResetError):
                    pass
            
            # For non-streaming client, build the full response then send headers
            # with Content-Length so the client knows the response is complete.
            if not client_stream:
                message = {'role': 'assistant', 'content': full_text}
                if full_reasoning:
                    message['reasoning_content'] = full_reasoning
                    message['reasoning'] = full_reasoning
                if tool_calls:
                    message['tool_calls'] = tool_calls
                openai_response = {
                    'id': response_id,
                    'object': 'chat.completion',
                    'created': created_ts,
                    'model': model,
                    'choices': [{
                        'index': 0,
                        'message': message,
                        'finish_reason': 'tool_calls' if tool_calls else 'stop'
                    }],
                    'usage': self._convert_usage(stream_state.get('usage') or {})
                }
                out_body = json.dumps(openai_response).encode()
                try:
                    self.send_response(response.status_code)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Content-Length", str(len(out_body)))
                    self.send_header("Connection", "close")
                    self.end_headers()
                    self.wfile.write(out_body)
                except (BrokenPipeError, ConnectionResetError):
                    pass
                
        except requests.RequestException as e:
            self.log_message(f"Error: {e}")
            self.send_error(502, str(e))
    
    def update_stream_state(self, sse_line, state):
        """Track stateful info across the SSE stream (tool calls, usage)."""
        if not sse_line or not sse_line.startswith('data: '):
            return
        try:
            event = json.loads(sse_line[6:])
            t = event.get('type', '')
            if t == 'response.output_item.added':
                item = event.get('item', {})
                if item.get('type') == 'function_call':
                    state['has_tool_calls'] = True
            elif t == 'response.completed':
                # Capture usage from the completed response
                usage = event.get('response', {}).get('usage')
                if usage:
                    state['usage'] = usage
        except:
            pass

    def convert_sse_to_openai(self, sse_line, model, response_id=None, created_ts=None, state=None):
        """Convert Codex Responses API SSE to OpenAI chat.completion.chunk format"""
        if not sse_line or not sse_line.startswith('data: '):
            return None
        data = sse_line[6:]
        if response_id is None:
            response_id = f"chatcmpl-{int(time.time()*1000)}"
        if created_ts is None:
            created_ts = int(time.time())
        try:
            event = json.loads(data)
            event_type = event.get('type', '')
            
            if event_type == 'response.output_text.delta':
                delta = event.get('delta', '')
                if delta:
                    return json.dumps({
                        'id': response_id,
                        'object': 'chat.completion.chunk',
                        'created': created_ts,
                        'model': model,
                        'choices': [{'index': 0, 'delta': {'content': delta}, 'finish_reason': None}]
                    })
            elif event_type == 'response.reasoning_summary_text.delta':
                # Reasoning/thinking deltas - expose as reasoning_content
                delta = event.get('delta', '')
                if delta:
                    return json.dumps({
                        'id': response_id,
                        'object': 'chat.completion.chunk',
                        'created': created_ts,
                        'model': model,
                        'choices': [{'index': 0, 'delta': {'reasoning_content': delta, 'reasoning': delta}, 'finish_reason': None}]
                    })
            elif event_type == 'response.output_item.added':
                # Handle function/tool calls
                item = event.get('item', {})
                if item.get('type') == 'function_call':
                    call_id = item.get('call_id') or item.get('id', '')
                    name = item.get('name', '')
                    return json.dumps({
                        'id': response_id,
                        'object': 'chat.completion.chunk',
                        'created': created_ts,
                        'model': model,
                        'choices': [{
                            'index': 0,
                            'delta': {
                                'tool_calls': [{
                                    'index': 0,
                                    'id': call_id,
                                    'type': 'function',
                                    'function': {'name': name, 'arguments': ''}
                                }]
                            },
                            'finish_reason': None
                        }]
                    })
            elif event_type == 'response.function_call_arguments.delta':
                # Streaming function call arguments
                delta = event.get('delta', '')
                if delta:
                    return json.dumps({
                        'id': response_id,
                        'object': 'chat.completion.chunk',
                        'created': created_ts,
                        'model': model,
                        'choices': [{
                            'index': 0,
                            'delta': {
                                'tool_calls': [{
                                    'index': 0,
                                    'function': {'arguments': delta}
                                }]
                            },
                            'finish_reason': None
                        }]
                    })
            elif event_type == 'response.completed':
                # Use stream state to get correct finish_reason and usage
                has_tool = bool(state and state.get('has_tool_calls'))
                # Also fall back to checking output array (in case state didn't track it)
                if not has_tool:
                    response_data = event.get('response', {})
                    output = response_data.get('output', [])
                    has_tool = any(item.get('type') == 'function_call' for item in output)
                finish_reason = 'tool_calls' if has_tool else 'stop'
                
                # Build chunk with usage if available
                chunk = {
                    'id': response_id,
                    'object': 'chat.completion.chunk',
                    'created': created_ts,
                    'model': model,
                    'choices': [{'index': 0, 'delta': {}, 'finish_reason': finish_reason}]
                }
                
                # Include usage in the final chunk (OpenAI streaming spec supports this)
                usage = event.get('response', {}).get('usage') or (state and state.get('usage'))
                if usage:
                    chunk['usage'] = self._convert_usage(usage)
                
                return json.dumps(chunk)
        except Exception as e:
            self.log_message(f"SSE parse error: {e}")
        return None
    
    def _convert_usage(self, codex_usage):
        """Convert Codex usage to OpenAI format"""
        return {
            'prompt_tokens': codex_usage.get('input_tokens', 0),
            'completion_tokens': codex_usage.get('output_tokens', 0),
            'total_tokens': codex_usage.get('total_tokens', 0),
            'prompt_tokens_details': {
                'cached_tokens': codex_usage.get('input_tokens_details', {}).get('cached_tokens', 0)
            },
            'completion_tokens_details': {
                'reasoning_tokens': codex_usage.get('output_tokens_details', {}).get('reasoning_tokens', 0)
            }
        }
    
    def extract_tool_call_from_sse(self, sse_line):
        """Extract tool call info from SSE line for non-streaming responses"""
        if not sse_line or not sse_line.startswith('data: '):
            return None
        data = sse_line[6:]
        try:
            event = json.loads(data)
            event_type = event.get('type', '')
            if event_type == 'response.output_item.done':
                item = event.get('item', {})
                if item.get('type') == 'function_call':
                    return {
                        'id': item.get('call_id') or item.get('id', ''),
                        'type': 'function',
                        'function': {
                            'name': item.get('name', ''),
                            'arguments': item.get('arguments', '')
                        }
                    }
        except:
            pass
        return None
    
    def extract_text_from_sse(self, sse_line):
        """Extract text deltas from SSE line for non-streaming responses"""
        if not sse_line or not sse_line.startswith('data: '):
            return None
        data = sse_line[6:]
        try:
            event = json.loads(data)
            event_type = event.get('type', '')
            # Only collect deltas - 'done' would duplicate
            if event_type == 'response.output_text.delta':
                return event.get('delta', '')
        except:
            pass
        return None
    
    def extract_reasoning_from_sse(self, sse_line):
        """Extract reasoning summary deltas from SSE line"""
        if not sse_line or not sse_line.startswith('data: '):
            return None
        data = sse_line[6:]
        try:
            event = json.loads(data)
            if event.get('type') == 'response.reasoning_summary_text.delta':
                return event.get('delta', '')
        except:
            pass
        return None


BANNER = r"""
                     __     _ __
 _______  ___  ___/ /_ __(_) /_
/ __/ _ \/ _ \/ _  / // / / __/
\__/\___/_//_/\_,_/\_,_/_/\__/

 ▸▸▸  codex auth → openai-compat  ▸▸▸
"""

def main():
    # Only print banner if we're attached to a terminal (avoid noise in launchd logs)
    if os.isatty(1):
        print(BANNER)
    
    if not os.path.exists(CODEX_AUTH_FILE):
        print(f"⚠  Codex auth file not found at {CODEX_AUTH_FILE}")
        print(f"   Run `codex login` first, then restart conduit.")
    else:
        print(f"✓ Conduit listening on http://localhost:{PROXY_PORT}")
        print(f"  OpenAI-compatible base URL: http://localhost:{PROXY_PORT}/v1")
        print(f"  Auth source: {CODEX_AUTH_FILE}")
    
    server = ThreadingHTTPServer(("localhost", PROXY_PORT), ProxyHandler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    
    try:
        while True:
            time.sleep(60)
    except KeyboardInterrupt:
        print("\nshutting down")
        server.shutdown()

if __name__ == "__main__":
    main()