{
  "codex-proxy": {
    "npm": "@ai-sdk/openai-compatible",
    "name": "Codex Enterprise (via Conduit)",
    "options": {
      "baseURL": "http://localhost:8081/v1"
    },
    "models": {
      "gpt-5.5": {
        "name": "GPT-5.5 (Enterprise)",
        "limit": { "context": 272000, "output": 100000 },
        "reasoning": true,
        "tool_call": true,
        "options": {
          "reasoning_effort": "xhigh",
          "reasoning_summary": "auto"
        }
      },
      "gpt-5.4": {
        "name": "GPT-5.4 (Enterprise, 1M context)",
        "limit": { "context": 1000000, "output": 100000 },
        "reasoning": true,
        "tool_call": true,
        "options": {
          "reasoning_effort": "medium",
          "reasoning_summary": "auto"
        }
      },
      "gpt-5.4-mini": {
        "name": "GPT-5.4-Mini (Enterprise)",
        "limit": { "context": 272000, "output": 100000 },
        "reasoning": true,
        "tool_call": true
      }
    }
  }
}
